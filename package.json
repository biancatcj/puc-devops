{
  "name": "api-pagamentos-trava-redis",
  "version": "1.0.0",
  "description": "API de pagamentos que usa uma trava distribuida no Redis para impedir o processamento em duplicidade da mesma fatura",
  "main": "src/servidor.js",
  "scripts": {
    "start": "node src/servidor.js",
    "test": "npm run test:unit",
    "test:unit": "jest --testPathPatterns=.unit.test.js",
    "test:integration": "jest --testPathPatterns=.integration.test.js --runInBand"
  },
  "keywords": [
    "redis",
    "trava-distribuida",
    "pagamentos",
    "devops"
  ],
  "author": "Bianca Thaina Carvalho Joba",
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "ioredis": "^5.9.0"
  },
  "devDependencies": {
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2"
  }
}
